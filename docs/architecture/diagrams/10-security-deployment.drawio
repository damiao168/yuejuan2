        <mxCell id="session" value="&lt;div style=&quot;font-size:72px;font-weight:bold;line-height:1.2;white-space:nowrap&quot;&gt;会话 Token Hash&lt;/div&gt;&lt;div style=&quot;font-size:32px;line-height:1.26;margin-top:6px;word-break:break-all&quot;&gt;密码 Argon2id&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#25364B;fillColor=#E9F6EE;strokeColor=#38835B;strokeWidth=1.5;" vertex="1" parent="1" evidence="services/api-gateway/internal/auth/password.go:36;services/api-gateway/internal/auth/token.go:11;services/api-gateway/internal/auth/managed_access_store.go:154" details="用户会话与密码&#10;密码Argon2id；兼容bcrypt并升级&#10;随机token，DB保存SHA-256 hash&#10;授权变更提升epoch并撤销会话" implementationStatus="implemented">
