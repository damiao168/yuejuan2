        <mxCell id="cipher" value="&lt;div style=&quot;font-size:72px;font-weight:bold;line-height:1.2;white-space:nowrap&quot;&gt;AES-GCM&lt;/div&gt;&lt;div style=&quot;font-size:32px;line-height:1.26;margin-top:6px;word-break:break-all&quot;&gt;tenant / config AAD&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#25364B;fillColor=#E9F6EE;strokeColor=#38835B;strokeWidth=1.5;" vertex="1" parent="1" evidence="services/api-gateway/internal/modelgovernance/managed_config.go:208" details="CredentialCipher&#10;SHA-256(masterKey) → AES-256-GCM&#10;随机nonce；AAD绑定tenantID+configID&#10;解密失败返回配置不可用" implementationStatus="implemented">
