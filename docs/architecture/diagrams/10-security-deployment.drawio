        <mxCell id="store" value="&lt;div style=&quot;font-size:72px;font-weight:bold;line-height:1.2;white-space:nowrap&quot;&gt;PG 密文&lt;/div&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#25364B;fillColor=#EAF2FF;strokeColor=#5278B0;strokeWidth=1.5;" vertex="1" parent="1" evidence="services/api-gateway/internal/modelgovernance/managed_config_store_postgres.go:44" details="PostgreSQL托管配置&#10;只保存ciphertext + nonce&#10;状态/能力探测/更新版本&#10;主密钥来自部署环境；图中无真实值" implementationStatus="infra">
