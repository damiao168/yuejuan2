{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EduGrade Desktop Client",
  "version": "0.1.0",
  "identifier": "com.edugrade.enterprise.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EduGrade Enterprise Client",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "connect-src": "ipc: http://ipc.localhost http: https:",
        "font-src": "'self' data:",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "frame-src": "blob:",
        "img-src": "'self' blob: data:",
        "media-src": "'none'",
        "object-src": "'none'",
        "script-src": "'self'",
        "script-src-attr": "'none'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "connect-src": "ipc: http://ipc.localhost http: https: ws://127.0.0.1:5180",
        "font-src": "'self' data:",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "frame-src": "blob:",
        "img-src": "'self' blob: data:",
        "media-src": "'none'",
        "object-src": "'none'",
        "script-src": "'self' 'unsafe-eval'",
        "script-src-attr": "'none'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'none'"
      },
      "dangerousDisableAssetCspModification": false,
      "capabilities": ["default"],
      "headers": {
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Education",
    "shortDescription": "EduGrade Enterprise Windows client",
    "longDescription": "EduGrade Enterprise Windows desktop client skeleton for scan upload, offline review, synchronization and diagnostics."
  }
}
