{
  "schema_version": "grading-agent-contract-v2",
  "capability_profile": "internal-image-contract-v2",
  "deployment_mode": "unreachable_fixture_only",
  "request_schema": "request.schema.json",
  "response_schema": "response.schema.json",
  "error_schema": "error.schema.json",
  "maximum_http_body_bytes": 8388608,
  "maximum_decoded_media_bytes": 5242880,
  "maximum_media_pixels": 12000000,
  "maximum_source_bbox_area": 0.9,
  "allowed_media_count": 1,
  "allowed_media_types": ["image/png"],
  "allowed_media_kinds": ["answer_segment_crop"],
  "allowed_media_encodings": ["base64"],
  "binding_algorithm": "sha256-length-prefixed-v1",
  "binding_parts": [
    "schema_version",
    "request_id",
    "question_id",
    "answer_segment_id",
    "media_evidence.sha256",
    "bbox_x_millionths",
    "bbox_y_millionths",
    "bbox_width_millionths",
    "bbox_height_millionths"
  ],
  "final_grade_publication_allowed": false,
  "student_visible": false,
  "human_review_required": true,
  "allowed_grade_levels": ["junior", "senior"],
  "allowed_subjects": ["chinese", "mathematics", "english", "physics", "chemistry", "biology", "history", "geography", "ethics_politics"],
  "allowed_agent_roles": ["single", "primary", "arbiter"],
  "http_route_enabled": false,
  "external_provider_enabled": false,
  "forbidden_request_fields": [
    "tenant_id",
    "school_id",
    "student_id",
    "student_name",
    "student_no",
    "class_id",
    "exam_id",
    "submission_id",
    "final_score",
    "published_score",
    "original_filename",
    "bucket",
    "storage_key",
    "url"
  ]
}
