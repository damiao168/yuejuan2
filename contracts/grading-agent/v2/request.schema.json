{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edugrade.local/contracts/grading-agent/v2/request.schema.json",
  "title": "Governed grading-agent image request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "subject",
    "grade_level",
    "agent_role",
    "question_id",
    "answer_segment_id",
    "question_type",
    "question_text",
    "max_score",
    "answer_text",
    "ocr_confidence",
    "rubric_version",
    "prompt_version",
    "rubric",
    "model_policy",
    "prompt_guard",
    "output_constraint",
    "media_evidence",
    "math_evidence"
  ],
  "properties": {
    "schema_version": {"const": "grading-agent-v2"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "subject": {
      "type": "string",
      "enum": ["chinese", "mathematics", "english", "physics", "chemistry", "biology", "history", "geography", "ethics_politics"]
    },
    "grade_level": {"type": "string", "enum": ["junior", "senior"]},
    "agent_role": {"type": "string", "enum": ["single", "primary", "arbiter"]},
    "question_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "answer_segment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "question_type": {"type": "string", "enum": ["short_answer", "calculation", "essay", "discussion"]},
    "question_text": {"type": "string", "minLength": 1, "maxLength": 12000},
    "max_score": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
    "answer_text": {"type": "string", "minLength": 1, "maxLength": 20000},
    "ocr_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rubric_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "prompt_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "rubric": {"$ref": "../v1/request.schema.json#/$defs/rubric"},
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "model_version", "min_confidence"],
      "properties": {
        "mode": {"const": "shadow"},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "min_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "prompt_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["student_answer_is_untrusted", "suspected_injection", "signals"],
      "properties": {
        "student_answer_is_untrusted": {"const": true},
        "suspected_injection": {"type": "boolean"},
        "signals": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "output_constraint": {"$ref": "../v1/request.schema.json#/properties/output_constraint"},
    "media_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "encoding",
        "media_type",
        "sha256",
        "byte_size",
        "width_pixels",
        "height_pixels",
        "normalized_bbox",
        "binding_hash",
        "data_base64"
      ],
      "properties": {
        "kind": {"const": "answer_segment_crop"},
        "encoding": {"const": "base64"},
        "media_type": {"const": "image/png"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 5242880},
        "width_pixels": {"type": "integer", "minimum": 1, "maximum": 12000000},
        "height_pixels": {"type": "integer", "minimum": 1, "maximum": 12000000},
        "normalized_bbox": {"$ref": "#/$defs/normalizedBbox"},
        "binding_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "data_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 6990508,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "math_evidence": {"$ref": "#/$defs/mathEvidence"},
    "reference_context": {"$ref": "#/$defs/referenceContext"}
  },
  "$defs": {
    "referenceContext": {
      "description": "Authored answer and worked solution from the confirmed exam import snapshot. Optional for legacy exams. This content interprets rubric criteria and does not change final score authority.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "snapshot_hash", "standard_answer", "equivalent_answers", "solution_text", "solution_steps"],
      "properties": {
        "source": {"const": "confirmed_exam_import_snapshot"},
        "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "standard_answer": {},
        "equivalent_answers": {"type": "array", "maxItems": 100, "items": {}},
        "solution_text": {"type": "string", "maxLength": 20000},
        "solution_steps": {
          "type": "array", "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["step_no", "content"],
            "properties": {
              "step_no": {"type": "integer", "minimum": 1},
              "content": {"type": "string", "maxLength": 4000}
            }
          }
        }
      }
    },
    "mathEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "correction_revision", "exam_question_snapshot_id", "scoring_version", "overall_confidence", "quality", "steps", "formulas", "verifications", "rubric_evidence", "has_diagram", "graph_uncertain", "required_rubric_uncertain"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact_version": {"type": "integer", "minimum": 1},
        "correction_revision": {"type": "integer", "minimum": 0},
        "exam_question_snapshot_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "scoring_version": {"const": "math-rubric-score-v1"},
        "overall_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "quality": {
          "type": "object", "additionalProperties": false,
          "required": ["recognition", "formula", "structure", "verification", "rubric_mapping", "critical"],
          "properties": {
            "recognition": {"type": "number", "minimum": 0, "maximum": 1},
            "formula": {"type": "number", "minimum": 0, "maximum": 1},
            "structure": {"type": "number", "minimum": 0, "maximum": 1},
            "verification": {"type": "number", "minimum": 0, "maximum": 1},
            "rubric_mapping": {"type": "number", "minimum": 0, "maximum": 1},
            "critical": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "steps": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/mathStep"}},
        "formulas": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/mathFormula"}},
        "verifications": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/mathVerification"}},
        "rubric_evidence": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/rubricEvidence"}},
        "has_diagram": {"type": "boolean"},
        "graph_uncertain": {"type": "boolean"},
        "required_rubric_uncertain": {"type": "boolean"}
      }
    },
    "mathStep": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "formula_ids", "confidence"],
      "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "text": {"type": "string", "maxLength": 4000}, "formula_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "mathFormula": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "step_ids", "parse_status", "reason_codes", "bbox", "confidence"],
      "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "step_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "canonical_latex": {"type": "string", "maxLength": 4000}, "parse_status": {"type": "string", "enum": ["parsed", "ambiguous", "unsupported", "failed"]}, "reason_codes": {"type": "array", "items": {"type": "string", "maxLength": 256}}, "bbox": {"$ref": "#/$defs/normalizedBbox"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "mathVerification": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status", "reason_code", "confidence"],
      "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "step_id": {"type": "string", "maxLength": 128}, "formula_id": {"type": "string", "maxLength": 128}, "kind": {"type": "string", "maxLength": 64}, "status": {"type": "string", "enum": ["verified", "contradicted", "uncertain", "not_applicable"]}, "reason_code": {"type": "string", "maxLength": 256}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "rubricEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rubric_criterion_key", "evidence_type", "source_artifact_ids", "status", "confidence"],
      "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "rubric_criterion_key": {"type": "string", "minLength": 1, "maxLength": 128}, "evidence_type": {"type": "string", "maxLength": 128}, "source_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "verification_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "status": {"type": "string", "enum": ["supported", "contradicted", "uncertain", "not_applicable", "unsupported"]}, "explanation": {"type": "string", "maxLength": 2000}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "normalizedBbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.000001},
        "y": {"type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.000001},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "multipleOf": 0.000001},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "multipleOf": 0.000001}
      }
    }
  }
}
