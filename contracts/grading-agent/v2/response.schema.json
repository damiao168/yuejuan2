{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edugrade.local/contracts/grading-agent/v2/response.schema.json",
  "title": "Governed mathematics criterion-candidate response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "status", "delivery", "criterion_candidates", "alternative_solution_candidate", "risk_flags", "needs_human_review", "model_version", "prompt_version", "rubric_version", "capability_profile", "mock", "telemetry"],
  "properties": {
    "schema_version": {"const": "grading-agent-v2"},
    "request_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "status": {"const": "candidate_mapping"},
    "delivery": {"const": "teacher_suggestion"},
    "criterion_candidates": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rubric_point_id", "status", "evidence_ids", "confidence", "reason_code"],
        "properties": {
          "rubric_point_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"type": "string", "enum": ["supported", "contradicted", "uncertain"]},
          "evidence_ids": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason_code": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "alternative_solution_candidate": {"type": "boolean"},
    "risk_flags": {"type": "array", "uniqueItems": true, "maxItems": 20, "items": {"type": "string", "enum": ["alternative_solution_candidate", "schema_repaired", "prompt_injection_suspected", "human_review_required"]}},
    "needs_human_review": {"const": true},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "prompt_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "rubric_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "capability_profile": {"type": "string", "minLength": 1, "maxLength": 128},
    "mock": {"const": false},
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "provider", "deployment", "region", "attempts", "repair_attempted", "prior_error_codes", "elapsed_ms"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1, "maxLength": 128},
        "provider": {"type": "string", "minLength": 1, "maxLength": 128},
        "deployment": {"type": "string", "minLength": 1, "maxLength": 128},
        "region": {"type": "string", "minLength": 1, "maxLength": 128},
        "attempts": {"type": "integer", "minimum": 1, "maximum": 2},
        "repair_attempted": {"type": "boolean"},
        "prior_error_codes": {"type": "array", "maxItems": 2, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "usage": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "cached_input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "reasoning_tokens": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
