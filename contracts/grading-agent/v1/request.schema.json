{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edugrade.local/contracts/grading-agent/v1/request.schema.json",
  "title": "Governed grading-agent request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "subject",
    "grade_level",
    "agent_role",
    "question_id",
    "answer_segment_id",
    "question_type",
    "question_text",
    "max_score",
    "answer_text",
    "ocr_confidence",
    "rubric_version",
    "prompt_version",
    "rubric",
    "model_policy",
    "prompt_guard",
    "output_constraint"
  ],
  "properties": {
    "schema_version": {"const": "grading-agent-v1"},
    "request_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "subject": {
      "type": "string",
      "enum": ["chinese", "mathematics", "english", "physics", "chemistry", "biology", "history", "geography", "ethics_politics"]
    },
    "grade_level": {"type": "string", "enum": ["junior", "senior"]},
    "agent_role": {"type": "string", "enum": ["single", "primary", "arbiter"]},
    "question_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "answer_segment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "question_type": {"type": "string", "enum": ["short_answer", "calculation", "essay", "discussion"]},
    "question_text": {"type": "string", "minLength": 1, "maxLength": 12000},
    "max_score": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
    "answer_text": {"type": "string", "minLength": 1, "maxLength": 20000},
    "ocr_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rubric_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "prompt_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "rubric": {"$ref": "#/$defs/rubric"},
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "model_version", "min_confidence"],
      "properties": {
        "mode": {"const": "shadow"},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "min_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "prompt_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["student_answer_is_untrusted", "suspected_injection", "signals"],
      "properties": {
        "student_answer_is_untrusted": {"const": true},
        "suspected_injection": {"type": "boolean"},
        "signals": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "output_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria_evidence_only", "allow_model_final_score", "final_score_authority"],
      "properties": {
        "criteria_evidence_only": {"const": true},
        "allow_model_final_score": {"const": false},
        "final_score_authority": {
          "type": "string",
          "enum": ["server_rubric_or_human_confirmation", "server_rubric_and_deterministic_rule", "human_review"]
        }
      }
    }
  },
  "$defs": {
    "rubricPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "score", "required", "aliases", "evidence_required", "match_policy"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "score": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        "required": {"type": "boolean"},
        "aliases": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "evidence_required": {"type": "boolean"},
        "match_policy": {"type": "string", "enum": ["semantic", "strict_alias"]}
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rubric_id",
        "rubric_version",
        "question_type",
        "max_score",
        "allow_partial_total",
        "points",
        "deductions",
        "equivalent_answers",
        "examples",
        "scoring_notes"
      ],
      "properties": {
        "rubric_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "rubric_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "question_type": {"type": "string", "enum": ["short_answer", "calculation", "essay", "discussion"]},
        "max_score": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        "allow_partial_total": {"type": "boolean"},
        "points": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/rubricPoint"}},
        "deductions": {"type": "array", "maxItems": 100},
        "equivalent_answers": {"type": "array", "maxItems": 100},
        "examples": {"type": "array", "maxItems": 100},
        "scoring_notes": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 2000}}
      }
    }
  }
}
