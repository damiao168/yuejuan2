{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edugrade.local/contracts/grading-agent/v1/response.schema.json",
  "title": "Governed grading-agent suggestion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "status",
    "delivery",
    "suggested_score",
    "max_score",
    "confidence",
    "matched_points",
    "missing_points",
    "deductions",
    "evidence",
    "risk_flags",
    "needs_human_review",
    "student_feedback",
    "teacher_note",
    "model_version",
    "prompt_version",
    "rubric_version",
    "capability_profile",
    "mock",
    "telemetry"
  ],
  "properties": {
    "schema_version": {
      "const": "grading-agent-v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "status": {
      "const": "suggestion"
    },
    "delivery": {
      "type": "string",
      "enum": [
        "teacher_suggestion",
        "shadow_only"
      ]
    },
    "suggested_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "max_score": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "matched_points": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rubric_point_id",
          "label",
          "score",
          "evidence_ids"
        ],
        "properties": {
          "rubric_point_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "missing_points": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rubric_point_id",
          "label",
          "reason"
        ],
        "properties": {
          "rubric_point_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "deductions": {
      "type": "array",
      "maxItems": 0
    },
    "evidence": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "rubric_point_id",
          "text_excerpt",
          "location",
          "confidence"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "rubric_point_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "text_excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "location": {
            "const": "answer_text"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ocr_low_confidence",
          "ocr_text_empty_review_required",
          "ambiguous_answer",
          "insufficient_evidence",
          "possible_off_topic",
          "score_needs_review",
          "schema_repaired",
          "prompt_injection_suspected",
          "human_review_required"
        ]
      }
    },
    "needs_human_review": {
      "const": true
    },
    "student_feedback": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "teacher_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "capability_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mock": {
      "const": false
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "attempts",
        "repair_attempted",
        "prior_error_codes",
        "elapsed_ms"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deployment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "repair_attempted": {
          "type": "boolean"
        },
        "prior_error_codes": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cached_input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "reasoning_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "execution_diagnostics": {
          "$ref": "#/$defs/execution_diagnostics"
        }
      }
    }
  },
  "$defs": {
    "execution_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finish_outcome",
        "attempts",
        "provider_request_count",
        "usage_status",
        "recovery_attempted"
      ],
      "properties": {
        "failure_kind": {
          "type": "string",
          "enum": [
            "output_truncated",
            "finish_reason_missing",
            "finish_reason_unknown",
            "provider_refused",
            "content_filtered",
            "unsupported_generation",
            "response_envelope_invalid",
            "schema_invalid",
            "evidence_invalid",
            "capability_unavailable"
          ]
        },
        "finish_outcome": {
          "type": "string",
          "enum": [
            "completed",
            "output_limit",
            "filtered_or_refused",
            "unsupported_generation",
            "finish_missing",
            "finish_unknown",
            "envelope_invalid",
            "unavailable"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "provider_request_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "usage_status": {
          "type": "string",
          "enum": [
            "reported",
            "partial",
            "unavailable",
            "invalid"
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "cached_input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "reasoning_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          }
        },
        "recovery_attempted": {
          "const": false
        },
        "recovery_blocked_reason": {
          "const": "not_enabled"
        },
        "output_token_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "usage_status": {
                "const": "reported"
              }
            }
          },
          "then": {
            "required": [
              "usage"
            ],
            "properties": {
              "usage": {
                "required": [
                  "input_tokens",
                  "output_tokens",
                  "total_tokens"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "usage_status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "usage"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "usage_status": {
                "const": "partial"
              }
            }
          },
          "then": {
            "required": [
              "usage"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "finish_outcome": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "failure_kind": {
                "enum": [
                  "schema_invalid",
                  "evidence_invalid"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "finish_outcome": {
                "const": "output_limit"
              }
            }
          },
          "then": {
            "properties": {
              "failure_kind": {
                "enum": [
                  "output_truncated"
                ]
              }
            },
            "required": [
              "failure_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "finish_outcome": {
                "const": "filtered_or_refused"
              }
            }
          },
          "then": {
            "properties": {
              "failure_kind": {
                "enum": [
                  "provider_refused",
                  "content_filtered"
                ]
              }
            },
            "required": [
              "failure_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "finish_outcome": {
                "const": "unsupported_generation"
              }
            }
          },
          "then": {
            "properties": {
              "failure_kind": {
                "enum": [
                  "unsupported_generation",
                  "capability_unavailable"
                ]
              }
            },
            "required": [
              "failure_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "finish_outcome": {
                "const": "finish_missing"
              }
            }
          },
          "then": {
            "properties": {
              "failure_kind": {
                "enum": [
                  "finish_reason_missing"
                ]
              }
            },
            "required": [
              "failure_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "finish_outcome": {
                "const": "finish_unknown"
              }
            }
          },
          "then": {
            "properties": {
              "failure_kind": {
                "enum": [
                  "finish_reason_unknown"
                ]
              }
            },
            "required": [
              "failure_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "finish_outcome": {
                "const": "envelope_invalid"
              }
            }
          },
          "then": {
            "properties": {
              "failure_kind": {
                "enum": [
                  "response_envelope_invalid"
                ]
              }
            },
            "required": [
              "failure_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "finish_outcome": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "failure_kind"
              ]
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "attempts": {
                  "const": 0
                },
                "provider_request_count": {
                  "const": 0
                }
              }
            },
            {
              "properties": {
                "attempts": {
                  "const": 1
                },
                "provider_request_count": {
                  "const": 1
                }
              }
            },
            {
              "properties": {
                "attempts": {
                  "const": 2
                },
                "provider_request_count": {
                  "const": 2
                }
              }
            }
          ]
        },
        {
          "properties": {
            "finish_outcome": {
              "const": "completed"
            }
          },
          "not": {
            "required": [
              "failure_kind"
            ]
          }
        }
      ]
    }
  }
}
