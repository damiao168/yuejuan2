EDUGRADE_ENV=local
EDUGRADE_IMAGE_TAG=local
# Runtime images may use tags locally. Production preflight requires every
# deployed and build-stage image below to use an immutable @sha256: digest.
EDUGRADE_POSTGRES_IMAGE=postgres:16-alpine
EDUGRADE_REDIS_IMAGE=redis:7-alpine
EDUGRADE_QDRANT_IMAGE=qdrant/qdrant:v1.14.1
EDUGRADE_API_GATEWAY_IMAGE=edugrade/api-gateway:local
EDUGRADE_WEB_ADMIN_IMAGE=edugrade/web-admin:local
EDUGRADE_GRADING_AGENT_IMAGE=edugrade/grading-agent:local
EDUGRADE_OCR_WORKER_IMAGE=edugrade/ocr-worker:local
EDUGRADE_IMAGE_QUALITY_WORKER_IMAGE=edugrade/image-quality-worker:local
EDUGRADE_SUBJECTIVE_GRADING_WORKER_IMAGE=edugrade/subjective-grading-worker:local
EDUGRADE_MATH_VERIFICATION_WORKER_IMAGE=edugrade/math-verification-worker:local
EDUGRADE_PAGE_PROCESSING_WORKER_IMAGE=edugrade/page-processing-worker:local
EDUGRADE_NGINX_IMAGE=nginx:1.29-alpine
EDUGRADE_PROMETHEUS_IMAGE=prom/prometheus:v3.4.2
EDUGRADE_GRAFANA_IMAGE=grafana/grafana:12.0.2
# Optional immutable override; defaults to EDUGRADE_OCR_WORKER_IMAGE.
EDUGRADE_PAPER_FORMULA_WORKER_IMAGE=
EDUGRADE_APP_VERSION=dev
EDUGRADE_GIT_SHA=unknown
EDUGRADE_BUILD_TIME=unknown
EDUGRADE_IMAGE_DIGEST=unknown
EDUGRADE_RELEASE_ID=local
EDUGRADE_SCHEMA_VERSION=000168
EDUGRADE_MIGRATION_BASELINE_VERSION=
EDUGRADE_LOG_LEVEL=info
EDUGRADE_READINESS_TIMEOUT=2s
EDUGRADE_SHUTDOWN_TIMEOUT=10s
EDUGRADE_SESSION_TTL=8h
EDUGRADE_REMEMBERED_SESSION_TTL=720h
EDUGRADE_PUBLIC_SESSION_TTL=4h
EDUGRADE_RECENT_AUTH_TTL=60m
EDUGRADE_LOGIN_FAILURE_LIMIT=5
EDUGRADE_LOGIN_FAILURE_WINDOW=15m
EDUGRADE_SESSION_COOKIE_NAME=edugrade_session
EDUGRADE_DEVICE_COOKIE_NAME=edugrade_device
EDUGRADE_SESSION_COOKIE_SECURE=false
EDUGRADE_AUTH_RISK_MODE=shadow
EDUGRADE_DEVICE_BINDING_TTL=4320h
# Optional authenticator-management pilot, not login/business MFA enforcement.
EDUGRADE_MFA_ENABLED=false
EDUGRADE_MFA_MASTER_KEY=
EDUGRADE_MFA_MASTER_KEY_FILE=
EDUGRADE_HTTP_MAX_HEADER_BYTES=1048576
EDUGRADE_MAX_REQUEST_BODY_BYTES=2097152
EDUGRADE_HTTP_READ_HEADER_TIMEOUT=5s
EDUGRADE_HTTP_READ_TIMEOUT=15s
EDUGRADE_HTTP_WRITE_TIMEOUT=780s
EDUGRADE_HTTP_IDLE_TIMEOUT=60s
EDUGRADE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5180,http://localhost:5180
EDUGRADE_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
EDUGRADE_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID,X-Trace-ID,Idempotency-Key,X-EduGrade-CSRF
EDUGRADE_TRUSTED_PROXY_CIDRS=

EDUGRADE_NGINX_HTTP_PORT=8088
EDUGRADE_API_PORT=8080
EDUGRADE_WEB_API_BASE_URL=

# Internal service ports (postgres/redis/minio/qdrant/api/prometheus/grafana)
# bind to loopback by default so only nginx is reachable from other machines.
# Override with 0.0.0.0 only on an isolated development host.
EDUGRADE_INTERNAL_BIND_HOST=127.0.0.1
EDUGRADE_INTERNAL_API_BASE_URL=http://api-gateway:8080
EDUGRADE_INTERNAL_MATH_VERIFY_BASE_URL=http://math-verification-worker:8092
# Production internal PKI: issue separate server certificates containing the
# api-gateway, grading-agent, and math-verification-worker Docker DNS names.
EDUGRADE_INTERNAL_CA_DIR=./certs/internal-ca
EDUGRADE_INTERNAL_CA_FILE=/run/secrets/internal-ca/ca.crt
EDUGRADE_INTERNAL_TLS_PORT=0
EDUGRADE_API_TLS_CERTS_DIR=./certs/api-gateway
EDUGRADE_INTERNAL_TLS_CERT_FILE=
EDUGRADE_INTERNAL_TLS_KEY_FILE=
EDUGRADE_GRADING_AGENT_TLS_CERTS_DIR=./certs/grading-agent
EDUGRADE_GRADING_AGENT_TLS_CERT_FILE=
EDUGRADE_GRADING_AGENT_TLS_KEY_FILE=
EDUGRADE_GRADING_AGENT_HEALTH_URL=http://127.0.0.1:8100/health
EDUGRADE_MATH_VERIFY_TLS_CERTS_DIR=./certs/math-verifier
EDUGRADE_MATH_VERIFY_TLS_CERT_FILE=
EDUGRADE_MATH_VERIFY_TLS_KEY_FILE=
EDUGRADE_MATH_VERIFY_HEALTH_URL=http://127.0.0.1:8092/healthz
EDUGRADE_CONTAINER_LOG_MAX_SIZE=10m
EDUGRADE_CONTAINER_LOG_MAX_FILES=5

# Per-service memory ceilings so a runaway worker cannot take down the
# database on a shared host. Raise these to match the deployment hardware.
EDUGRADE_POSTGRES_MEM_LIMIT=2g
EDUGRADE_REDIS_MEM_LIMIT=512m
EDUGRADE_MINIO_MEM_LIMIT=1g
EDUGRADE_QDRANT_MEM_LIMIT=2g
EDUGRADE_API_MEM_LIMIT=1g
EDUGRADE_GRADING_AGENT_MEM_LIMIT=2g
EDUGRADE_OCR_WORKER_MEM_LIMIT=4g
EDUGRADE_IMAGE_QUALITY_MEM_LIMIT=2g
# page-processing validates the PDF pixel budget before rendering, then keeps
# permitted page images in memory while preparing the document. Size this
# ceiling for EDUGRADE_PAGE_PROCESSING_MAX_TOTAL_PIXELS and lower that budget
# first on smaller hosts.
EDUGRADE_PAGE_PROCESSING_MEM_LIMIT=8g

EDUGRADE_POSTGRES_DB=edugrade
EDUGRADE_POSTGRES_USER=edugrade
EDUGRADE_POSTGRES_PASSWORD=change_me_postgres_demo
EDUGRADE_POSTGRES_APP_USER=edugrade_app
EDUGRADE_POSTGRES_APP_PASSWORD=change_me_postgres_app_demo_secret
EDUGRADE_POSTGRES_PORT=5432
EDUGRADE_POSTGRES_ADMIN_DSN=postgres://edugrade:change_me_postgres_demo@postgres:5432/edugrade?sslmode=disable
EDUGRADE_POSTGRES_DSN=postgres://edugrade_app:change_me_postgres_app_demo_secret@postgres:5432/edugrade?sslmode=disable
EDUGRADE_POSTGRES_TENANT_RLS=false
EDUGRADE_POSTGRES_MAX_OPEN_CONNS=10
EDUGRADE_POSTGRES_MAX_IDLE_CONNS=5
EDUGRADE_POSTGRES_CONN_MAX_LIFETIME=30m
EDUGRADE_POSTGRES_CONN_MAX_IDLE_TIME=5m
EDUGRADE_POSTGRES_STATEMENT_TIMEOUT=60s
EDUGRADE_POSTGRES_LOCK_TIMEOUT=5s

EDUGRADE_REDIS_PASSWORD=change_me_redis_demo
EDUGRADE_REDIS_USERNAME=edugrade-api
EDUGRADE_REDIS_PORT=6379
EDUGRADE_REDIS_DB=0
EDUGRADE_REDIS_TLS_ENABLED=false
# Production: mount server.crt/server.key/ca.crt below EDUGRADE_REDIS_CERTS_DIR,
# mount the issuing CA as ca.crt below EDUGRADE_REDIS_CA_DIR, then enable TLS.
EDUGRADE_REDIS_CERTS_DIR=./certs/redis
EDUGRADE_REDIS_CA_DIR=./certs/redis-ca
EDUGRADE_REDIS_TLS_CA_FILE=/run/secrets/redis-ca/ca.crt
EDUGRADE_REDIS_TLS_SERVER_NAME=redis
EDUGRADE_AUTH_LIMITER_FAIL_CLOSED=false

EDUGRADE_MINIO_ROOT_USER=edugrade-root
EDUGRADE_MINIO_ROOT_PASSWORD=change_me_minio_root_demo_secret
EDUGRADE_MINIO_APP_ACCESS_KEY=edugrade-app
EDUGRADE_MINIO_APP_SECRET_KEY=change_me_minio_app_demo_secret
EDUGRADE_MINIO_USE_SSL=false
# Production: mount public.crt/private.key below EDUGRADE_MINIO_CERTS_DIR and
# the issuing CA as ca.crt below EDUGRADE_MINIO_CA_DIR, then enable TLS.
EDUGRADE_MINIO_CERTS_DIR=./certs/minio
EDUGRADE_MINIO_CA_DIR=./certs/minio-ca
EDUGRADE_MINIO_TLS_CA_FILE=/run/secrets/minio-ca/ca.crt
EDUGRADE_MINIO_TLS_SERVER_NAME=minio
EDUGRADE_MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
EDUGRADE_MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-04-16T18-13-26Z
EDUGRADE_MINIO_API_PORT=9000
EDUGRADE_MINIO_CONSOLE_PORT=9001
EDUGRADE_FILE_BUCKET=edugrade-files
EDUGRADE_FILE_MAX_UPLOAD_BYTES=104857600
EDUGRADE_FILE_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tif,.tiff,.csv,.docx,.txt,.md,.markdown
EDUGRADE_FILE_RECONCILIATION_INTERVAL=24h
EDUGRADE_FILE_RECONCILIATION_STALE_AFTER=1h
EDUGRADE_FILE_RECONCILIATION_BATCH_SIZE=200
EDUGRADE_FILE_RECONCILIATION_OBJECT_LIMIT=1000
EDUGRADE_BARCODE_ACTIVE_KEY_ID=local-v1
EDUGRADE_BARCODE_HMAC_KEYS=local-v1:replace_with_at_least_32_random_characters

EDUGRADE_QDRANT_HTTP_PORT=6333
EDUGRADE_QDRANT_GRPC_PORT=6334
EDUGRADE_QDRANT_URL=http://qdrant:6333
EDUGRADE_QDRANT_API_KEY=change_me_qdrant_demo_key_32_chars_min

EDUGRADE_AI_SERVICE_URL=http://grading-agent:8100
EDUGRADE_AI_GRADING_ENABLED=true
EDUGRADE_MATH_GRADING_V2_ENABLED=false
EDUGRADE_ALLOW_MOCK_AI=false
EDUGRADE_GRADING_AGENT_TOKEN=replace_with_a_grading_agent_token_of_at_least_32_chars
EDUGRADE_MATH_VERIFY_TOKEN=replace_with_a_distinct_math_token_of_at_least_32_chars
EDUGRADE_AI_SERVICE_TIMEOUT=750s
EDUGRADE_AI_SERVICE_MAX_RETRIES=0
EDUGRADE_AI_MODEL_VERSION=Qwen/Qwen3-4B-GGUF:Q4_K_M
EDUGRADE_AI_PROMPT_VERSION=subjective-governed-cn-subject-routing-v6
EDUGRADE_AI_MIN_CONFIDENCE=0.8
EDUGRADE_AI_PROVIDER_KEY=local
EDUGRADE_AI_DEPLOYMENT_KEY=local-qwen3-4b-q4-k-m
EDUGRADE_AI_ADAPTER_TYPE=local_llama_cpp
EDUGRADE_AI_DEPLOYMENT_REGION=on_premise
EDUGRADE_AI_CAPABILITY_PROFILE=local-pilot-v1
EDUGRADE_GRADING_MODEL_BASE_URL=http://host.docker.internal:8087/v1
EDUGRADE_GRADING_MODEL_READINESS_CACHE_SECONDS=10
EDUGRADE_GRADING_MODEL_API_KEY=
EDUGRADE_GRADING_MODEL_NAME=qwen3-4b-q4-k-m
EDUGRADE_GRADING_MODEL_TIMEOUT_SECONDS=600
EDUGRADE_GRADING_MODEL_READY_TIMEOUT_SECONDS=3
EDUGRADE_GRADING_MODEL_QUEUE_TIMEOUT_SECONDS=5
EDUGRADE_GRADING_MODEL_MAX_RETRIES=1
EDUGRADE_GRADING_MODEL_MAX_OUTPUT_TOKENS=512
EDUGRADE_SLOW_REQUEST_THRESHOLD=2s
EDUGRADE_WORKER_HEARTBEAT_STALE_AFTER=30s

EDUGRADE_OCR_INSTALL_PADDLEOCR=true
EDUGRADE_OCR_INSTALL_PADDLEOCR_HPI=false
# Relative paths are resolved from infra/docker-compose. This keeps downloaded
# PaddleOCR and formula models inside the repository at .cache/ocr-models.
EDUGRADE_OCR_MODEL_CACHE_DIR=../../.cache/ocr-models
EDUGRADE_PYPI_INDEX_URL=https://pypi.org/simple
EDUGRADE_DEBIAN_MIRROR=http://deb.debian.org/debian
EDUGRADE_DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
EDUGRADE_OCR_WORKER_TENANT_CODE=platform
EDUGRADE_OCR_WORKER_USERNAME=ocr_worker
EDUGRADE_OCR_WORKER_PASSWORD=
EDUGRADE_OCR_ENGINE=paddleocr
EDUGRADE_OCR_ENGINE_VERSION=pp-ocrv5
EDUGRADE_OCR_MODEL_VERSION=ppocr-v5-mobile
EDUGRADE_OCR_MIN_CONFIDENCE=0.8
EDUGRADE_OCR_POLL_INTERVAL=5
EDUGRADE_OCR_BATCH_SIZE=1
EDUGRADE_OCR_DEVICE=cpu
EDUGRADE_OCR_PREPROCESS_PROFILE=default
EDUGRADE_OCR_CPU_THREADS=4
EDUGRADE_OCR_ENABLE_MKLDNN=auto
EDUGRADE_OCR_ENABLE_HPI=false
EDUGRADE_OCR_USE_TEXTLINE_ORIENTATION=true
EDUGRADE_OCR_TEXT_DET_LIMIT_TYPE=min
EDUGRADE_OCR_TEXT_DET_LIMIT_SIDE_LEN=64
EDUGRADE_OCR_TEXT_RECOGNITION_BATCH_SIZE=1
EDUGRADE_OCR_WORKER_ID=ocr-worker-1
EDUGRADE_OCR_LEASE_SECONDS=300
EDUGRADE_OCR_HEARTBEAT_INTERVAL=10
EDUGRADE_OCR_HEARTBEAT_TIMEOUT=3
EDUGRADE_OCR_RUNTIME_ENABLED=true
EDUGRADE_MATH_RUNTIME_ENABLED=true
EDUGRADE_FORMULA_MODEL_VERSION=PP-FormulaNet_plus-M
EDUGRADE_FORMULA_LAYOUT_MODEL_VERSION=PP-DocLayout_plus-L
# auto uses a compatible measured deployment profile; without one the safe batch is 1.
EDUGRADE_FORMULA_RECOGNITION_BATCH_SIZE=auto
EDUGRADE_FORMULA_RESULT_CACHE_SIZE=2048
EDUGRADE_FORMULA_MAX_PADDING_PIXELS=96
EDUGRADE_FORMULA_MAX_PADDING_HEIGHT_RATIO=0.75
EDUGRADE_FORMULA_RENDER_SIMILARITY_THRESHOLD=0.34
EDUGRADE_FORMULA_MODEL_LIFECYCLE=auto
EDUGRADE_FORMULA_DEPLOYMENT_PROFILE_PATH=/home/ocr-worker/.paddlex/edugrade/formula-deployment-profile.json
EDUGRADE_FORMULA_PREWARM_FALLBACK=false
EDUGRADE_PAPER_FORMULA_LEASE_SECONDS=900
EDUGRADE_PAPER_FORMULA_WORKER_MEM_LIMIT=8g
EDUGRADE_PAPER_FORMULA_WORKER_CPU_LIMIT=4.0
EDUGRADE_MATH_RECOGNITION_WORKER_CPU_LIMIT=4.0

EDUGRADE_IMAGE_QUALITY_TENANT_CODE=platform
EDUGRADE_IMAGE_QUALITY_USERNAME=image_quality_worker
EDUGRADE_IMAGE_QUALITY_PASSWORD=
EDUGRADE_IMAGE_QUALITY_BATCH_SIZE=1
EDUGRADE_IMAGE_QUALITY_LEASE_SECONDS=300
EDUGRADE_IMAGE_QUALITY_POLL_INTERVAL=5
EDUGRADE_IMAGE_QUALITY_WORKER_ID=image-quality-worker-1

EDUGRADE_PAGE_PROCESSING_TENANT_CODE=platform
EDUGRADE_PAGE_PROCESSING_USERNAME=page_processing_worker
EDUGRADE_PAGE_PROCESSING_PASSWORD=
