{
  "name": "edugrade-enterprise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web-admin run dev",
    "build": "npm --workspaces --if-present run build",
    "generate:sdk": "node scripts/generate-sdk.mjs",
    "generate:route-coverage": "node scripts/update-api-route-coverage.mjs",
    "openapi:baseline": "node scripts/update-openapi-baseline.mjs",
    "check:openapi-breaking": "node scripts/check-openapi-breaking.mjs",
    "check:story049": "node scripts/check-story049-ocr-worker.mjs",
    "check:story052": "node scripts/check-story052-production-deployment.mjs",
    "check:story053": "node scripts/check-story053-product-shell.mjs",
    "check:story057": "node scripts/check-story057-grading-contract.mjs",
    "check:story061": "node scripts/check-story061-model-evaluation-ui.mjs",
    "check:story063": "node scripts/check-story063-subjective-grading.mjs",
    "check:onboarding": "node scripts/check-onboarding.mjs",
    "lab:test": "npm --prefix lab test",
    "lab:eval": "npm --prefix lab run eval",
    "lab:gate:dev": "npm --prefix lab run gate:dev",
    "check:lab-integration": "node scripts/check-lab-integration.mjs",
    "check:architecture-boundaries": "node scripts/check-architecture-boundaries.mjs",
    "test:architecture-boundaries": "node --test scripts/ci/architecture-boundaries.test.mjs",
    "check:schema-version": "node scripts/check-schema-version.mjs",
    "test:schema-version": "node --test scripts/ci/schema-version.test.mjs",
    "test:contract-gates": "node --test scripts/ci/contract-gates.test.mjs",
    "sync:schema-version": "node scripts/sync-schema-version.mjs",
    "ci:workflow-lint": "node scripts/ci/lint-workflows.mjs",
    "ci:web:fast": "npm run lint && npm run typecheck && npm run build",
    "ci:contracts": "node scripts/ci/check-generated-contracts.mjs && npm run check:openapi-breaking && npm run test:contract-gates && npm run check:schema-version",
    "ci:web:full": "npm run ci:web:fast && npm run ci:contracts && npm --workspaces --if-present run test",
    "check:user-facing-copy": "node scripts/check-user-facing-copy.mjs",
    "lint": "biome lint",
    "typecheck": "npm run check:user-facing-copy && npm --workspaces --if-present run typecheck",
    "preview": "npm --workspace apps/web-admin run preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "showcase:exam-workspace": "playwright test tests/e2e/specs/exam-workspace.visual.spec.ts --project=chromium",
    "showcase:exam-workspace:ui": "playwright test tests/e2e/specs/exam-workspace.visual.spec.ts --project=chromium --ui",
    "test:e2e:report": "playwright show-report output/playwright/report"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0"
  }
}
